{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Deezer RPC Tauri",
    "version": "0.0.1",
    "identifier": "com.deezer-rpc",
    "app": {
        "windows": [
            {
                "title": "Deezer",
                "url": "https://account.deezer.com/login/",
                "width": 800,
                "height": 600,
                "resizable": true,
                "fullscreen": false
            }
        ], "trayIcon": {
            "iconPath": "assets/64x.png"
        }, "withGlobalTauri": true
    },
    "bundle": {
        "active": true, "category": "Music", "icon": [
            "assets/32x.png", "assets/64x.png", "assets/128x.png", "assets/256x.png",
            "assets/512x.png", "assets/icon.png", "assets/icon.icns", "assets/icon.ico"
        ], "publisher": "Zalko", "targets": "all"
    }
}
